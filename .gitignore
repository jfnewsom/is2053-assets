# Python cache — never commit these
__pycache__/
*.pyc
*.pyo
 
# Checkpoint graphics — generated artifacts, can be regenerated
checkpoints/
 
# Slide PNG output folders — generated artifacts, can be regenerated
slides/**/*_pngs/

# macOS Finder metadata
.DS_Store
**/.DS_Store
_to_delete/git-index.lock

# AI Assist check output (tools/ai_check). In GitHub Actions it is saved as
# a downloadable artifact instead.
ai_check_results/
